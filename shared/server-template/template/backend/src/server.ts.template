import { dirname, resolve } from 'node:path'
import { fileURLToPath } from 'node:url'
import express from 'express'
import { loadActiveConfig } from '@shared/config-loader'

const moduleDir = dirname(fileURLToPath(import.meta.url))
const appRoot = resolve(moduleDir, '..', '..')
const configFile = resolve(appRoot, 'lab-configs.json')
const frontendDist = resolve(appRoot, 'frontend', 'dist')

const labId = process.env.LAB_ID ?? process.env.LAB_CONFIG ?? 'baseline'
const port = Number(process.env.PORT ?? 3000)

const cfg = loadActiveConfig({ configFile, labId })

const app = express()
app.disable('x-powered-by')
app.use(express.json({ limit: '1mb' }))

app.get('/health', (_req, res) => {
  res.json({ ok: true, labId: cfg.id })
})

app.get('/api/lab-info', (_req, res) => {
  res.json({ labId: cfg.id, description: cfg.description, defects: cfg.defects })
})

app.use(express.static(frontendDist))
app.get(/^\/(?!api\/|health$).*/, (_req, res) => {
  res.sendFile(resolve(frontendDist, 'index.html'))
})

app.listen(port, '0.0.0.0', () => {
  console.log(`server listening on ${port} (labId=${cfg.id})`)
})
